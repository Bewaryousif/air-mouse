<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>b4b9c0a1-3e2d-4f6a-9c7b-1a2b3c4d5e6f</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>src\main.py</StartupFile>
    <SearchPath>src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>AirMouse</Name>
    <RootNamespace>AirMouse</RootNamespace>
    <InterpreterId>Global|PythonCore|3.11</InterpreterId>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\main.py" />
    <Compile Include="src\config.py" />
    <Compile Include="src\hand_tracker.py" />
    <Compile Include="src\gesture_recognizer.py" />
    <Compile Include="src\mouse_controller.py" />
    <Compile Include="src\air_mouse_app.py" />
    <Compile Include="src\ui_overlay.py" />
    <Compile Include="src\__init__.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="requirements.txt" />
    <Content Include="README.md" />
    <Content Include="config.json" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
